using System;
using System.Collections.Generic;
using System.Linq;
using System.Web;
using System.Web.UI;
using System.Web.UI.WebControls;
using System.Data;
using System.Data.SQLite;
using System.Configuration;

public partial class PropertyForRent : System.Web.UI.Page
{
    protected void Page_Load(object sender, EventArgs e)
    {
        if (!Page.IsPostBack)
        {
            string mainconn = ConfigurationManager.ConnectionStrings["MyConnection"].ConnectionString;
            using (SQLiteConnection con = new SQLiteConnection(mainconn))
            {
                string sqlquery = "SELECT * FROM PropertyForRent ORDER BY type";
                using (SQLiteCommand sqlconn = new SQLiteCommand(sqlquery, con))
                {
                    con.Open();
                    using (SQLiteDataAdapter sda = new SQLiteDataAdapter(sqlconn))
                    {
                        DataTable dt = new DataTable();
                        sda.Fill(dt);
                        
                        PropertyRepeater.DataSource = dt;
                        PropertyRepeater.DataBind();
                    }
                }
            }
        }
    }

    protected string GetCityImage(object cityObj, object propertyNoObj)
    {
        // 1. Check for a locally uploaded image first
        string propNo = propertyNoObj?.ToString() ?? "";
        if (!string.IsNullOrEmpty(propNo))
        {
            string[] extensions = { "jpg", "jpeg", "png", "gif", "webp" };
            string folder = Server.MapPath("~/Images/Properties/");
            foreach (var ext in extensions)
            {
                if (System.IO.File.Exists(System.IO.Path.Combine(folder, propNo + "." + ext)))
                    return ResolveUrl("~/Images/Properties/" + propNo + "." + ext);
            }
        }

        // 2. Fall back to city-based Unsplash image
        string city = cityObj?.ToString()?.ToLower() ?? "";

        // Scottish cities
        if (city.Contains("glasgow"))
            return "https://images.unsplash.com/photo-1568605114967-8130f3a36994?auto=format&fit=crop&w=600&q=80";
        if (city.Contains("edinburgh"))
            return "https://images.unsplash.com/photo-1506905925346-21bda4d32df4?auto=format&fit=crop&w=600&q=80";
        if (city.Contains("aberdeen"))
            return "https://images.unsplash.com/photo-1564013799919-ab600027ffc6?auto=format&fit=crop&w=600&q=80";
        if (city.Contains("dundee"))
            return "https://images.unsplash.com/photo-1600596542815-ffad4c1539a9?auto=format&fit=crop&w=600&q=80";

        // English cities
        if (city.Contains("london"))
            return "https://images.unsplash.com/photo-1513635269975-59663e0ac1ad?auto=format&fit=crop&w=600&q=80";
        if (city.Contains("manchester"))
            return "https://images.unsplash.com/photo-1558618666-fcd25c85cd64?auto=format&fit=crop&w=600&q=80";
        if (city.Contains("bristol"))
            return "https://images.unsplash.com/photo-1570129477492-45c003edd2be?auto=format&fit=crop&w=600&q=80";
        if (city.Contains("birmingham"))
            return "https://images.unsplash.com/photo-1486325212027-8081e485255e?auto=format&fit=crop&w=600&q=80";
        if (city.Contains("leeds"))
            return "https://images.unsplash.com/photo-1512917774080-9991f1c4c750?auto=format&fit=crop&w=600&q=80";
        if (city.Contains("liverpool"))
            return "https://images.unsplash.com/photo-1523217582562-09d0def993a6?auto=format&fit=crop&w=600&q=80";
        if (city.Contains("sheffield"))
            return "https://images.unsplash.com/photo-1605276374104-dee2a0ed3cd6?auto=format&fit=crop&w=600&q=80";
        if (city.Contains("bristol"))
            return "https://images.unsplash.com/photo-1571939228382-b2f2b585ce15?auto=format&fit=crop&w=600&q=80";
        if (city.Contains("cambridge") || city.Contains("oxford"))
            return "https://images.unsplash.com/photo-1558618666-fcd25c85cd64?auto=format&fit=crop&w=600&q=80";

        // Default — attractive modern house
        return "https://images.unsplash.com/photo-1582268611958-ebfd161ef9cf?auto=format&fit=crop&w=600&q=80";
    }

    /// <summary>Returns true when the current user is authenticated and in the Seller role.</summary>
    protected bool IsSeller()
    {
        return User.Identity.IsAuthenticated && User.IsInRole("Seller");
    }

    protected void PropertyRepeater_ItemCommand(object source, RepeaterCommandEventArgs e)
    {
        if (e.CommandName == "Buy")
        {
            if (!User.Identity.IsAuthenticated)
            {
                Response.Redirect("~/Account/Login.aspx");
                return;
            }

            string propertyNo = e.CommandArgument.ToString();
            string userId = Microsoft.AspNet.Identity.IdentityExtensions.GetUserId(User.Identity);
            
            string mainconn = ConfigurationManager.ConnectionStrings["MyConnection"].ConnectionString;
            using (SQLiteConnection con = new SQLiteConnection(mainconn))
            {
                string sqlquery = "INSERT INTO Purchases (PropertyNo, UserId, PurchaseDate) VALUES (@PropertyNo, @UserId, @PurchaseDate)";
                using (SQLiteCommand sqlconn = new SQLiteCommand(sqlquery, con))
                {
                    sqlconn.Parameters.AddWithValue("@PropertyNo", propertyNo);
                    sqlconn.Parameters.AddWithValue("@UserId", userId);
                    sqlconn.Parameters.AddWithValue("@PurchaseDate", DateTime.Now);
                    
                    con.Open();
                    int rows = sqlconn.ExecuteNonQuery();
                    if (rows > 0)
                    {
                        PurchaseMessage.Text = $"Successfully purchased property {propertyNo}! We will contact you soon.";
                        PurchaseMessage.CssClass = "text-success";
                    }
                    else
                    {
                        PurchaseMessage.Text = "An error occurred during purchase.";
                        PurchaseMessage.CssClass = "text-danger";
                    }
                }
            }
        }
    }
}